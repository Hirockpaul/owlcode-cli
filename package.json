{
  "name": "owlcode",
  "version": "1.0.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/cli dev",
    "dev:server": "bun --env-file=../../.env run --cwd packages/server dev",
    "dev:cli": "bun run --cwd packages/cli dev",
    "build:cli": "bun run --filter @owlcode/cli build",
    "build:cli:release": "bun run --filter @owlcode/cli build:release",
    "release:build": "bash scripts/build-release.sh",
    "release:manifest": "bun scripts/generate-manifest.mjs",
    "link:cli": "bun run build:cli && cd packages/cli && bun link"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "docx": "^9.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "opentui-spinner": "^0.0.7"
  },
  "description": "Visit the installation website for setup instructions and downloads.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hirockpaul/owlcode-cli.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Hirockpaul/owlcode-cli/issues"
  },
  "homepage": "https://github.com/Hirockpaul/owlcode-cli#readme"
}
